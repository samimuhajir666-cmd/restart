
# Speech-to-Text AI Agent Configuration
# Copy this file to .env and update with your settings
 
# Audio Thresholds (in dB)
# SILENCE_THRESHOLD: Audio level below this is considered silence
SILENCE_THRESHOLD=30
 
# LOUD_THRESHOLD: Audio level above this is considered too loud/distorted (will be skipped)
LOUD_THRESHOLD=70
 
# NOISE_THRESHOLD: Audio level below this is considered background noise
NOISE_THRESHOLD=40
 
# Energy threshold for speech recognition (0-4000, higher = less sensitive)
ENERGY_THRESHOLD=4000
 
# ============================================================
# Optional API Keys (if using cloud services)
# ============================================================
 
# Google Cloud Speech-to-Text
# Get your key from: https://cloud.google.com/speech-to-text/docs/quickstart-client-libraries
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
 
# OpenAI API (for Whisper model)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
 
# ============================================================
# Agent Configuration
# ============================================================
 
# Agent name
AGENT_NAME=VoiceAssistant
 
# Language for speech recognition
LANGUAGE=en-US
 
# Enable debug logging
DEBUG=False
 
# ============================================================
# Timeout Settings (in seconds)
# ============================================================
 
# How long to wait for speech input
LISTEN_TIMEOUT=5
 
# Maximum duration of a single speech phrase
PHRASE_TIME_LIMIT=15
 
# Pause between listening cycles
LISTEN_CYCLE_PAUSE=0.5
